# Frontend public configuration only.
# Never place Supabase secret/service-role keys in VITE_* variables.
VITE_API_URL=https://f-insight-api.onrender.com

# Supabase Auth uses the active public project URL plus a publishable browser key.
# Prefer the modern sb_publishable_ key. Legacy anon is supported only for compatibility.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=
