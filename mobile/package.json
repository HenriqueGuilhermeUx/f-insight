{
  "name": "finsight-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android",
    "build:android:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew :app:assembleRelease",
    "build:android:aab:local": "expo prebuild --platform android --clean && cd android && ./gradlew :app:bundleRelease",
    "eas:apk": "eas build --platform android --profile preview",
    "eas:aab": "eas build --platform android --profile production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~56.0.22",
    "expo-linear-gradient": "~15.0.8",
    "react": "19.2.3",
    "react-native": "0.85.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.3",
    "typescript": "^5.9.0"
  }
}
